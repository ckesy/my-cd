# npm 源统一配置
#
# 为什么需要这个文件：
#   CI 环境的 registry 曾被设成 `http://mirrors.tencent.com/`（**少了 /npm 这一段**），
#   npm 的 replace-registry-host 会把 package-lock.json 里的
#   `https://registry.npmjs.org/xxx/-/xxx-1.0.0.tgz`
#   替换成 `http://mirrors.tencent.com/xxx/-/xxx-1.0.0.tgz`，
#   于是所有包都 404（例如 npm-run-path@4.0.1）。
#
#   这里显式声明完整路径，避免任何环境把源配串。
registry=https://mirrors.tencent.com/npm/

# 构建环境不需要这些，关掉可以少一轮网络请求
fund=false
audit=false
