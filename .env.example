# 前端构建变量（Vite：只有 VITE_ 前缀会被注入浏览器）
# ⚠️ 本文件只放「可以公开」的变量。真正的密钥（东风 Token、COS SecretKey）绝不能放这里，
#    它们只存在于云函数环境变量中，见下方「云函数环境变量」。
# 用法：cp .env.example .env 然后填值；.env 已被 .gitignore 排除。

# ---------- CloudBase（anon key 设计上即可公开） ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------- 东风网关 ----------
# 不填则用内置默认网关地址；换环境时只需改这里
VITE_DONGFENG_GATEWAY=

# ---------- 高德（JS API Key 前端必然公开，安全靠控制台域名白名单约束） ----------
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

# ============================================================
# 云函数环境变量（在 CloudBase 控制台 → 云函数 → 函数配置 中设置，不写进 .env）
# ============================================================
# DONGFENG_TOKEN     东风开放平台 Token —— dongfeng-track 等 7 个函数必填
# ALLOWED_ORIGINS    允许调用网关的来源域名，逗号分隔，如 https://a.com,https://b.com
# AMAP_WEB_KEY       高德 Web 服务 Key（停留/超速分析云函数用）
# COS_SECRET_ID      COS 子账号 SecretId（仅限单桶 reports/ 读写）
# COS_SECRET_KEY     COS 子账号 SecretKey
# COS_BUCKET         桶名全称，形如 xxx-1254135806
# COS_REGION         默认 ap-shanghai
# CLOUDBASE_APIKEY   HTTP 访问服务调用时必需
# TCB_ENV            数据库环境
# RDB_SCHEMA         默认 public
