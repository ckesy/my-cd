<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '40px 64px 24px 64px', flexDirection: 'column' }}>
    <Box style={{ height: 78, flexDirection: 'row', alignItems: 'flex-start' }}>
        <Box style={{ width: 4, height: 30, background: '#C8102E', marginTop: 4 }} />
        <Box style={{ marginLeft: 14, flexDirection: 'column' }}>
            <Text style={{ fontSize: 12, color: '#C8102E', fontWeight: 700, letterSpacing: 2 }}>02　为什么要有</Text>
            <Text style={{ fontSize: 34, color: '#111827', fontWeight: 700, lineHeight: 1.2, marginTop: 6 }}>六个老麻烦，六个新做法</Text>
        </Box>
        <Box style={{ flex: 1 }} />
        <Text style={{ fontSize: 13, color: '#6B7280', marginTop: 34 }}>同一个环节，换个干法</Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', paddingTop: 6 }}>
        {/* 表头 */}
        <Box style={{ flexDirection: 'row', alignItems: 'flex-end', paddingBottom: 10, borderBottom: '2px solid #111827' }}>
            <Text style={{ fontSize: 12.5, color: '#9AA3AF', fontWeight: 700, letterSpacing: 2, width: 480 }}>过 去 怎 么 干</Text>
            <Box style={{ width: 60 }} />
            <Text style={{ fontSize: 12.5, color: '#C8102E', fontWeight: 700, letterSpacing: 2, width: 560 }}>现 在 怎 么 做</Text>
        </Box>

        {[
            ['派单在微信群里喊，谁接了记不清', '建单直接指派到车到人，接了没接一屏看清，超时未接自动标红'],
            ['车到哪了，只能打电话问', '地图上看位置和轨迹：已走多少、还剩多少公里、大概几点到'],
            ['到场时间全凭司机一张嘴', '装货地卸货地画了圈，车进圈出圈自动记时间，不用人核对'],
            ['费用报多少给多少，凭证留在相册里', '一笔费用必须配照片，谁审的、谁打的款、什么时间，全留痕'],
            ['月底对账要三天 Excel', '台账自动汇总，按车、按人、按分公司、按客户随筛随导'],
            ['保养年检靠人脑记，过期才知道', '到期前提前提醒，超期车辆单独列出来，谁负责一目了然']
        ].map((r, i) => (
            <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', flex: 1, borderBottom: '1px solid #E7E9EE' }}>
                <Box style={{ width: 480, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 14, height: 1, background: '#C7CCD6' }} />
                    <Text style={{ fontSize: 14.5, color: '#9AA3AF', lineHeight: 1.6 }}>{r[0]}</Text>
                </Box>
                <Box style={{ width: 60, alignItems: 'center' }}>
                    <Text style={{ fontSize: 17, color: '#C8102E', fontWeight: 700 }}>→</Text>
                </Box>
                <Text style={{ fontSize: 14.5, color: '#111827', fontWeight: 600, lineHeight: 1.6, width: 560 }}>{r[1]}</Text>
            </Box>
        ))}

        <Box style={{ marginTop: 18, flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <Box style={{ width: 3, height: 18, background: '#C8102E' }} />
            <Text style={{ fontSize: 14.5, color: '#374151' }}>
                说白了就一句：把<Text style={{ fontWeight: 700 }}>靠人记、靠嘴问</Text>的环节，换成<Text style={{ fontWeight: 700 }}>系统记、随时查</Text>。
            </Text>
        </Box>
    </Box>

    <Box style={{ height: 24, flexDirection: 'row', alignItems: 'center' }}>
        <Text style={{ fontSize: 12, color: '#9AA3AF' }}>车队一体化运营平台</Text>
        <Box style={{ flex: 1 }} />
        <Text style={{ fontSize: 12, color: '#9AA3AF' }}>03 / 14</Text>
    </Box>
</Slide>
