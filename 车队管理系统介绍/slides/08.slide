<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '40px 64px 24px 64px', flexDirection: 'column' }}>
    <Box style={{ height: 78, flexDirection: 'row', alignItems: 'flex-start' }}>
        <Box style={{ width: 4, height: 30, background: '#C8102E', marginTop: 4 }} />
        <Box style={{ marginLeft: 14, flexDirection: 'column' }}>
            <Text style={{ fontSize: 12, color: '#C8102E', fontWeight: 700, letterSpacing: 2 }}>07　管理端 · 费用透明</Text>
            <Text style={{ fontSize: 34, color: '#111827', fontWeight: 700, lineHeight: 1.2, marginTop: 6 }}>每一笔钱，都有照片、有名有姓</Text>
        </Box>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'row', gap: 34, paddingTop: 2 }}>
        <Image src="assets/shot_fee_drawer.png" style={{ width: 264, height: 459 }} />

        <Box style={{ flex: 1, flexDirection: 'column' }}>
            <Text style={{ fontSize: 14.5, color: '#374151', lineHeight: 1.8, width: 800 }}>
                过路费、加油、吃饭、装卸，先垫后报最怕"报了不认"。现在一笔费用就是一张卡：<Text style={{ fontWeight: 700 }}>金额、事由、照片、审批、付款，全在一处。</Text>
            </Text>

            <Box style={{ flexDirection: 'column', marginTop: 16 }}>
                {[
                    ['上报', '司机拍张照就报了', '金额 + 费用类型 + 凭证照，一笔一张卡，糊不掉也赖不掉', '例：过路费 200 元 + 一张票据照'],
                    ['审批', '谁审的一目了然', '按金额分档，小钱一路过、大钱多一级，审过的签字留在单子上', '例：500 元以下调度审，以上财务再审'],
                    ['打款', '打没打款有回执', '付款方式与回执一起存，钱什么时候出去的、去的哪，都有据', '例：已打款要驳回，先撤付款再驳'],
                    ['对账', '一单到底能对平', '整单费用合起来看，跟运单一起结，月底不用再拉 Excel', '例：按车、按人、按客户、按分公司都能筛']
                ].map((it, i) => (
                    <Box key={i} style={{ flexDirection: 'row', gap: 14, paddingBottom: 14, marginBottom: 14, borderBottom: i < 3 ? '1px solid #EDEEF1' : 'none' }}>
                        <Text style={{ fontSize: 12, color: '#C8102E', fontWeight: 800, width: 22, marginTop: 3 }}>{'0' + (i + 1)}</Text>
                        <Box style={{ flexDirection: 'column', width: 800 }}>
                            <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 10 }}>
                                <Text style={{ fontSize: 16, color: '#111827', fontWeight: 700 }}>{it[0]}</Text>
                                <Text style={{ fontSize: 12.5, color: '#C8102E', fontWeight: 700 }}>{it[1]}</Text>
                            </Box>
                            <Text style={{ fontSize: 12.5, color: '#4B5563', lineHeight: 1.65, marginTop: 4 }}>{it[2]}</Text>
                            <Text style={{ fontSize: 11, color: '#9AA3AF', marginTop: 3 }}>{it[3]}</Text>
                        </Box>
                    </Box>
                ))}
            </Box>
        </Box>
    </Box>

    <Box style={{ flexDirection: 'row', alignItems: 'center', background: '#111827', borderRadius: 4, padding: '15px 22px', marginTop: 12 }}>
        <Text style={{ fontSize: 12, color: '#C8102E', fontWeight: 800, letterSpacing: 2, marginRight: 18 }}>一 笔 费 用</Text>
        <Text style={{ fontSize: 15, color: '#E5E7EB' }}>＝ 金额 ＋ 照片 ＋ 审批链 ＋ 付款记录，缺一条就过不去</Text>
    </Box>

    <Box style={{ height: 24, flexDirection: 'row', alignItems: 'center', marginTop: 6 }}>
        <Text style={{ fontSize: 12, color: '#9AA3AF' }}>车队一体化运营平台</Text>
        <Box style={{ flex: 1 }} />
        <Text style={{ fontSize: 12, color: '#9AA3AF' }}>08 / 14</Text>
    </Box>
</Slide>
