<Slide style={{ width: 1280, height: 720, background: '#F4F5F7', padding: '40px 64px 24px 64px', flexDirection: 'column' }}>
    <Box style={{ height: 78, flexDirection: 'row', alignItems: 'flex-start' }}>
        <Box style={{ width: 4, height: 30, background: '#C8102E', marginTop: 4 }} />
        <Box style={{ marginLeft: 14, flexDirection: 'column' }}>
            <Text style={{ fontSize: 12, color: '#C8102E', fontWeight: 700, letterSpacing: 2 }}>03　怎么跑起来</Text>
            <Text style={{ fontSize: 34, color: '#111827', fontWeight: 700, lineHeight: 1.2, marginTop: 6 }}>一趟货，四段路，十步闭环</Text>
        </Box>
        <Box style={{ flex: 1 }} />
        <Text style={{ fontSize: 13, color: '#6B7280', marginTop: 34 }}>每一步都有责任人和时间</Text>
    </Box>

    <Box style={{ flexDirection: 'row', gap: 14, height: 336 }}>
        {[
            { n: '01', t: '调度', who: '调度员在电脑上', out: '一张可执行的运单', items: ['建单：货名、装货地、卸货地', '指派：指定车辆与司机', '约定：装货与送达时间', '常驻任务：一趟排好按趟走'] },
            { n: '02', t: '运输', who: '司机在手机上', out: '接单、装车、发车三条记录', items: ['接单：一键确认接这趟', '装车：到装货地拍照打卡', '发车：确认发车，途中位置可见', '极简或详细，走单方式可配'] },
            { n: '03', t: '到场', who: '司机与收货方', out: '到场时间与签收结果', items: ['到达：进卸货地范围自动打卡', '签收：卸完确认，状态收口', '异常：货损、压车拍照上报', '超时未到，管理端自动提醒'] },
            { n: '04', t: '结算', who: '财务在手机上', out: '一笔有凭证的付款', items: ['上报：费用带凭证提交', '审批：按金额分级逐级放行', '打款：付款留回执，自动进台账', '对账：按车按人按客户可筛'] }
        ].map((c, i) => (
            <Box key={i} style={{ flex: 1, background: '#FFFFFF', borderRadius: 6, flexDirection: 'column', padding: '20px 20px 18px 20px', position: 'relative', overflow: 'hidden' }}>
                <Box style={{ position: 'absolute', right: 8, top: 46 }}>
                    <Text style={{ fontSize: 92, color: '#111827', fontWeight: 800, opacity: 0.05, lineHeight: 1.0 }}>{c.n}</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
                    <Text style={{ fontSize: 12, color: '#C8102E', fontWeight: 800, letterSpacing: 1 }}>{c.n}</Text>
                    <Text style={{ fontSize: 21, color: '#111827', fontWeight: 700, letterSpacing: 2 }}>{c.t}</Text>
                </Box>
                <Box style={{ width: 28, height: 2, background: '#C8102E', marginTop: 10, marginBottom: 12 }} />
                <Box style={{ flexDirection: 'column', gap: 10 }}>
                    {c.items.map((it, j) => (
                        <Box key={j} style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 7 }}>
                            <Text style={{ fontSize: 10.5, color: '#C8102E', fontWeight: 800, marginTop: 4 }}>{'0' + (j + 1)}</Text>
                            <Text style={{ fontSize: 13, color: '#374151', lineHeight: 1.6, width: 196 }}>{it}</Text>
                        </Box>
                    ))}
                </Box>
                <Box style={{ flex: 1 }} />
                <Box style={{ paddingTop: 10, borderTop: '1px dashed #DDE1E8' }}>
                    <Text style={{ fontSize: 11, color: '#9AA3AF', fontWeight: 700, letterSpacing: 1 }}>这一步产出</Text>
                    <Text style={{ fontSize: 12.5, color: '#111827', fontWeight: 700, lineHeight: 1.5, marginTop: 3 }}>{c.out}</Text>
                </Box>
            </Box>
        ))}
    </Box>

    <Box style={{ flex: 1, marginTop: 14, background: '#FFFFFF', borderRadius: 6, padding: '16px 22px', flexDirection: 'column' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
            <Text style={{ fontSize: 12.5, color: '#C8102E', fontWeight: 700, letterSpacing: 2 }}>运单状态怎么走</Text>
            <Box style={{ flex: 1 }} />
            <Text style={{ fontSize: 11.5, color: '#9AA3AF' }}>状态自己往前走，不靠人催；谁改的、什么时候改的，都留着</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 6, marginTop: 12 }}>
            {['待接单', '待装车', '装车完成', '已发车', '已到达', '已完成'].map((s, i) => (
                <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 6 }}>
                    <Box style={{ padding: '7px 14px', borderRadius: 3, background: i === 5 ? '#C8102E' : '#EDEEF1' }}>
                        <Text style={{ fontSize: 12.5, color: i === 5 ? '#FFFFFF' : '#374151', fontWeight: 700 }}>{s}</Text>
                    </Box>
                    {i < 5 ? <Text style={{ fontSize: 12, color: '#C7CCD6' }}>›</Text> : null}
                </Box>
            ))}
            <Box style={{ width: 22 }} />
            <Text style={{ fontSize: 11.5, color: '#9AA3AF' }}>旁支</Text>
            <Box style={{ padding: '7px 12px', borderRadius: 3, border: '1px solid #E0E4EA' }}>
                <Text style={{ fontSize: 12, color: '#6B7280' }}>待重新指派</Text>
            </Box>
            <Box style={{ padding: '7px 12px', borderRadius: 3, border: '1px solid #E0E4EA' }}>
                <Text style={{ fontSize: 12, color: '#6B7280' }}>已取消</Text>
            </Box>
        </Box>
        <Box style={{ height: 1, background: '#EDEEF1', marginTop: 14 }} />
        <Box style={{ flexDirection: 'row', gap: 20, marginTop: 12 }}>
            {[['早上看一眼就知道', '今天该发几趟、哪几趟卡住了，首页一目了然'], ['卡点自己会亮', '超时没接单、超时没到场，红点直接推给负责人'], ['有争议能倒查', '每一步谁做的、几点做的、传了什么照片，都在']].map((it, i) => (
                <Box key={i} style={{ flex: 1, flexDirection: 'row', gap: 8 }}>
                    <Box style={{ width: 3, background: '#C8102E', marginTop: 2 }} />
                    <Box style={{ flexDirection: 'column' }}>
                        <Text style={{ fontSize: 12.5, color: '#111827', fontWeight: 700 }}>{it[0]}</Text>
                        <Text style={{ fontSize: 11.5, color: '#6B7280', lineHeight: 1.6, marginTop: 4 }}>{it[1]}</Text>
                    </Box>
                </Box>
            ))}
        </Box>
    </Box>

    <Box style={{ height: 24, flexDirection: 'row', alignItems: 'center', marginTop: 8 }}>
        <Text style={{ fontSize: 12, color: '#9AA3AF' }}>车队一体化运营平台</Text>
        <Box style={{ flex: 1 }} />
        <Text style={{ fontSize: 12, color: '#9AA3AF' }}>04 / 14</Text>
    </Box>
</Slide>
