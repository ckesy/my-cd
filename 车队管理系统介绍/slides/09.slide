<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '40px 64px 24px 64px', flexDirection: 'column' }}>
    <Box style={{ height: 78, flexDirection: 'row', alignItems: 'flex-start' }}>
        <Box style={{ width: 4, height: 30, background: '#C8102E', marginTop: 4 }} />
        <Box style={{ marginLeft: 14, flexDirection: 'column' }}>
            <Text style={{ fontSize: 12, color: '#C8102E', fontWeight: 700, letterSpacing: 2 }}>08　管理端 · 成本与能效</Text>
            <Text style={{ fontSize: 34, color: '#111827', fontWeight: 700, lineHeight: 1.2, marginTop: 6 }}>一台车跑得值不值，用数说话</Text>
        </Box>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'row', gap: 32, paddingTop: 4 }}>
        <Box style={{ width: 356, flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 12 }}>
                {[['24', '台', '在管车辆'], ['26.2', '万公里', '整月总里程'], ['130', 'kWh', '百公里电耗'], ['81', '%', '出车率']].map((it, i) => (
                    <Box key={i} style={{ width: 172, height: 104, background: '#F4F5F7', borderRadius: 4, padding: '12px 16px', flexDirection: 'column' }}>
                        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 4 }}>
                            <Text style={{ fontSize: 38, color: i === 2 ? '#C8102E' : '#111827', fontWeight: 800, lineHeight: 1.0, letterSpacing: -1 }}>{it[0]}</Text>
                            <Text style={{ fontSize: 12, color: '#6B7280', fontWeight: 600 }}>{it[1]}</Text>
                        </Box>
                        <Box style={{ flex: 1 }} />
                        <Text style={{ fontSize: 12, color: '#6B7280' }}>{it[2]}</Text>
                    </Box>
                ))}
            </Box>

            <Text style={{ fontSize: 14, color: '#374151', lineHeight: 1.85, marginTop: 18 }}>
                这些数不是月底拉表算出来的，是每天跑出来的：<br />
                谁的电耗高、谁急加速多、哪台车在空转，报告里都点得出名字。
            </Text>

            <Box style={{ flexDirection: 'column', gap: 8, marginTop: 14 }}>
                {['空转最久的车 → 先看排班是不是排多了', '电耗高于队均的车 → 先查驾驶习惯', '出车率偏低的分公司 → 单独看运力够不够'].map((t, i) => (
                    <Box key={i} style={{ flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
                        <Text style={{ fontSize: 10.5, color: '#C8102E', fontWeight: 800, marginTop: 3 }}>▪</Text>
                        <Text style={{ fontSize: 12.5, color: '#4B5563', lineHeight: 1.6, width: 320 }}>{t}</Text>
                    </Box>
                ))}
            </Box>

            <Box style={{ flex: 1 }} />

            <Box style={{ background: '#111827', borderRadius: 4, padding: '13px 18px' }}>
                <Text style={{ fontSize: 12, color: '#C8102E', fontWeight: 800, letterSpacing: 2 }}>省 在 哪</Text>
                <Text style={{ fontSize: 12.5, color: '#E5E7EB', lineHeight: 1.8, marginTop: 8 }}>
                    电耗高的车先查驾驶习惯，<br />空转多的线路先调排班——<br />省下来的都是纯利润。
                </Text>
            </Box>
        </Box>

        <Box style={{ flex: 1, flexDirection: 'column' }}>
            <Image src="assets/shot_analysis.png" style={{ width: 746, height: 417 }} />
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginTop: 12 }}>
                <Box style={{ width: 14, height: 2, background: '#C8102E' }} />
                <Text style={{ fontSize: 11.5, color: '#9AA3AF' }}>月度车队分析报告：里程、电耗、驾驶行为、能耗排名，一次生成</Text>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 10, marginTop: 14 }}>
                {['车队档案一目了然', '分段路况电耗', '驾驶行为排名', '单车能耗对比', '能耗趋势'].map((t, i) => (
                    <Box key={i} style={{ padding: '7px 12px', borderRadius: 3, border: '1px solid #E0E4EA' }}>
                        <Text style={{ fontSize: 11.5, color: '#4B5563', fontWeight: 600 }}>{t}</Text>
                    </Box>
                ))}
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 24, flexDirection: 'row', alignItems: 'center' }}>
        <Text style={{ fontSize: 12, color: '#9AA3AF' }}>车队一体化运营平台</Text>
        <Box style={{ flex: 1 }} />
        <Text style={{ fontSize: 12, color: '#9AA3AF' }}>09 / 14</Text>
    </Box>
</Slide>
